    <string name="settings_terms_section_1_title">1. Acceptance of terms</string>
    <string name="settings_terms_section_1_content">By accessing and using Solennix, you agree to be bound by these terms and conditions. If you disagree with any part of these terms, you may not access the service.</string>
    <string name="settings_terms_section_2_title">2. Service description</string>
    <string name="settings_terms_section_2_content">Solennix is an event management platform that lets users organize clients, create quotes, manage inventory, and generate professional documents such as contracts and proposals.</string>
    <string name="settings_terms_section_3_title">3. Registration and account</string>
    <string name="settings_terms_section_3_content">To use Solennix you must:
• Provide accurate and up-to-date information
• Keep your password confidential
• Notify us immediately about any unauthorized use
• Be responsible for all activity under your account</string>
    <string name="settings_terms_section_4_title">4. Acceptable use</string>
    <string name="settings_terms_section_4_content">You agree not to use Solennix for:
• Illegal or fraudulent activities
• Violating intellectual property rights
• Distributing malware or harmful content
• Interfering with service operations
• Collecting data from other users without authorization</string>
    <string name="settings_terms_section_5_title">5. Subscriptions and payments</string>
    <string name="settings_terms_section_5_content">Some services require a paid subscription:
• Prices are shown in Mexican pesos (MXN)
• Subscriptions renew automatically
• You can cancel at any time from Google Play Store
• Refunds are processed according to Google Play policies</string>
    <string name="settings_terms_section_6_title">6. Intellectual property</string>
    <string name="settings_terms_section_6_content">Solennix and its original content, features, and functionality are the exclusive property of Creapolis. The service is protected by copyright, trademark, and other intellectual property laws.</string>
    <string name="settings_terms_section_7_title">7. User content</string>
    <string name="settings_terms_section_7_content">You keep all rights to the content you upload to Solennix. By uploading content, you grant us a limited license to store, process, and display that content only to provide the service to you.</string>
    <string name="settings_terms_section_8_title">8. Limitation of liability</string>
    <string name="settings_terms_section_8_content">Solennix is provided &quot;as is&quot; without warranties of any kind. We will not be liable for indirect, incidental, special, or consequential damages arising from use of the service or inability to use it.</string>
    <string name="settings_terms_section_9_title">9. Termination</string>
    <string name="settings_terms_section_9_content">We may suspend or terminate your access to the service immediately, without prior notice, for any reason, including a breach of these terms.</string>
    <string name="settings_terms_section_10_title">10. Modifications</string>
    <string name="settings_terms_section_10_content">We reserve the right to modify these terms at any time. Changes take effect immediately after publication. Continued use of the service constitutes acceptance of the modified terms.</string>
    <string name="settings_terms_section_11_title">11. Governing law</string>
    <string name="settings_terms_section_11_content">These terms are governed by and interpreted according to the laws of Mexico, without regard to conflict-of-law provisions.</string>
    <string name="settings_terms_section_12_title">12. Contact</string>
    <string name="settings_terms_section_12_content">For questions about these terms, contact us at: legal@solennix.com</string>
