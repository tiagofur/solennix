<?xml version="1.0" encoding="utf-8"?>
<!--
  Solennix splash icon — golden cup on transparent background.
  Single source of truth: docs/Marketing/logos/svg/solennix-icon-transparent-filled.svg
  Same artwork as ic_launcher_foreground.xml but with the brand gradient + full sparkle,
  and no adaptive-icon background (transparent) so it floats on the splash background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Golden brand gradient (matches the SVG) -->
    <group>
        <path
            android:name="bowl"
            android:fillColor="@color/splash_gold_top"
            android:pathData="M66,34 Q58,65 66,88 Q78,116 100,122 Q122,116 134,88 Q142,65 134,34 Q100,42 66,34 Z" />
        <path
            android:name="reflection"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.12"
            android:pathData="M76,38 Q72,58 76,82 Q85,104 100,112 L100,42 Q82,44 76,38 Z" />
        <path
            android:name="node"
            android:fillColor="@color/splash_gold_top"
            android:pathData="M100,124 m-6,0 a6,3 0 1,0 12,0 a6,3 0 1,0 -12,0" />
        <path
            android:name="stem"
            android:fillColor="@color/splash_gold_mid"
            android:pathData="M96,124 L96,150 Q96,156 84,159 L72,161 L72,164 A30,8 0 0,0 128,164 L128,161 L116,159 Q104,156 104,150 L104,124 Z" />
    </group>

    <!-- Sparkle (#F5F0E8, opacity 0.65) — full 4-point sparkle + diagonals from the SVG -->
    <group
        android:name="sparkle"
        android:pivotX="132"
        android:pivotY="32">
        <path
            android:strokeColor="@color/splash_sparkle"
            android:strokeAlpha="0.65"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:pathData="M132,24 L132,40" />
        <path
            android:strokeColor="@color/splash_sparkle"
            android:strokeAlpha="0.65"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:pathData="M124,32 L140,32" />
        <path
            android:strokeColor="@color/splash_sparkle"
            android:strokeAlpha="0.5"
            android:strokeWidth="0.8"
            android:strokeLineCap="round"
            android:pathData="M128,28 L136,36" />
        <path
            android:strokeColor="@color/splash_sparkle"
            android:strokeAlpha="0.5"
            android:strokeWidth="0.8"
            android:strokeLineCap="round"
            android:pathData="M136,28 L128,36" />
        <path
            android:fillColor="@color/splash_sparkle"
            android:fillAlpha="0.5"
            android:pathData="M132,32 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
    </group>
</vector>
