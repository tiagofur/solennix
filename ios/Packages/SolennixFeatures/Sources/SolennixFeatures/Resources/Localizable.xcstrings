    "settings.delete_account.grace_warning" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account will enter a 90-day grace period. During this time, your information will be safely backed up and you can revoke this request by contacting support in case you change your mind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta entrará en un período de gracia de 90 días. Durante este tiempo, tu información estará resguardada de forma segura y podrás revocar esta solicitud contactándote con soporte en caso de que cambies de opinión."
          }
        }
      }
    },
    "settings.delete_account.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We understand you want to delete your account. Please read carefully what will happen next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entendemos que quieras eliminar tu cuenta. Por favor lee atentamente lo que sucederá a continuación."
          }
        }
      }
    },
