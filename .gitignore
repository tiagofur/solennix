.env
.env.production
.DS_Store
**/.DS_Store
testsprite_tests/tmp/
nul

# Local agent / skill cache (regenerable)
.atl/.skill-registry.cache.json

# Scratch marketing screenshots (keep docs/Marketing/**/final/)
docs/Marketing/smartphone/Screenshot_*.png
docs/Marketing/smartphone/Simulator Screenshot*.png

# Xcode
#
build/
DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.xcscmblueprint
*.xcuserstate
*.moved-aside
*.hmap
*.ipa
*.playground/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved
# Apps need a checked-in Package.resolved for reproducible CI builds
# (Xcode Cloud disables automatic dependency resolution).
!ios/Solennix.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# CocoaPods (si aplica)
# Pods/
.claude/settings.local.json
video/node_modules/
video/out/
solennix-release.jks

# Node Modules
node_modules/

# Solennix iOS secrets (keep template, ignore real values)
ios/Config/Secrets.xcconfig
ios/apple-keys/
android/google-services.json
.claude/settings.local.json
web/lint_output.txt
web/check_i18n_results.json
web/pages_test_output.txt
web/test_run.json
web/test_run_output.txt

# Backend local artifacts (also listed under backend/.gitignore)
backend/server
backend/main.exe
backend/coverage.out
backend/cookies.txt
backend/login_cookies.txt
backend/test_output.txt
backend/tests_out.txt
